     "definition": "The original TIFF file used to import the bitmap group."
    },
    {
     "type": "short_integer",
     "name": "color plate width*:pixels"
    },
    {
     "type": "short_integer",
     "name": "color plate height*:pixels"
    },
    {
     "type": "data",
     "name": "compressed color plate data*",
     "definition": "color_plate_data"
    },
    {
     "type": "explanation",
