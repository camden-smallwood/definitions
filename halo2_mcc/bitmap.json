     "definition": "Pixel data after being processed by the tool."
    },
    {
     "type": "data",
     "name": "processed pixel data*",
     "definition": "bitmap_pixel_data"
    },
    {
     "type": "explanation",
     "name": "miscellaneous",
     "definition": ""
    },
    {
     "type": "real",
     "name": "blur filter size:[0,10] pixels#blurs the bitmap before generating mipmaps"
    },
    {
     "type": "real",
     "name": "alpha bias:[-1,1]#affects alpha mipmap generation"
    },
    {
     "type": "short_integer",
     "name": "mipmap count:levels#0 defaults to all levels"
    },
    {
     "type": "explanation",
     "name": "...more sprite processing",
     "definition": "Sprite usage controls the background color of sprite plates."
    },
    {
     "type": "short_enum",
     "name": "sprite usage",
