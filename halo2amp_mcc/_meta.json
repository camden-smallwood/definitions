      "spawn_points": {
        "source": "halo2a_tag_test.exe 0x1414E5F10; the cell comes from the owning squad: its designer cells, or its templated cells once it has a template",
        "label": [
          {
            "format": "NONE: {name}",
            "when": "{cell|index} == -1"
          },
          {
            "format": "ERROR: {name}",
            "when": "{#group} != \"scnr\""
          },
          {
            "format": "{../designer/cells[{cell|index}]}: {name}",
            "when": "{../squad template index} == -1 && {cell|index} >= 0 && {cell|index} < {../designer/cells|count}"
          },
          {
            "format": "{../templated/cells[{cell|index}]}: {name}",
            "when": "{../squad template index} != -1 && {cell|index} >= 0 && {cell|index} < {../templated/cells|count}"
          },
          {
            "format": "BAD {cell|index}: {name}",
            "when": "1"
          }
        ]
