      "cinematic_shot_object_function": {
        "source": "halo3odst_mcc_guerilla.exe 0x1402C32D0; reads the owning tag as a cinematic scene",
        "label": [
          {
            "format": "{#}. {/objects[{object|index}]/name} ({function name})",
            "when": "{#group} == \"cisc\" && {object|index} >= 0 && {object|index} < {/objects|count}"
          },
          {
            "format": "{#}. NONE ({function name})",
            "when": "1"
          }
        ]
      },
      "cinematic_shot_object_function_keyframe": {
        "source": "halo3odst_mcc_guerilla.exe 0x1402C3260",
        "label": [
