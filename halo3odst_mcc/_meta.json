      },
      "scenario_object": {
        "source": "halo3odst_mcc_guerilla.exe 0x140302230",
        "label": [
          {
            "format": "{name|none:|bad:<invalid name>} {type|none:NONE|bad:BAD}",
            "when": "{#group} == \"scnr\""
          },
