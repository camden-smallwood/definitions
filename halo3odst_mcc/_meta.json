      "zone_set": {
        "source": "halo3odst_mcc_guerilla.exe 0x140A9AE90",
        "label": [
          {
            "format": "Invalid zone",
            "when": "{#group} == \"scnr\" && ({zone|index} < 0 || {zone|index} >= {/zones|count})"
          },
          {
            "format": "NONE ({/zones[{zone|index}]/name})",
            "when": "{#group} == \"scnr\" && {area|index} == -1"
          },
          {
            "format": "Invalid area ({/zones[{zone|index}]/name})",
            "when": "{#group} == \"scnr\" && ({area|index} < 0 || {area|index} >= {/zones[{zone|index}]/areas|count})"
          },
          {
            "format": "{/zones[{zone|index}]/areas[{area|index}]/name} ({/zones[{zone|index}]/name})",
            "when": "{#group} == \"scnr\""
          },
          {
            "format": "zone {zone|index}: area {area|index}",
            "when": "1"
          }
        ]
      },
      "spawn_points": {
        "source": "halo3odst_mcc_guerilla.exe 0x140A54290; the cell comes from the owning squad: its designer cells, or its templated cells once it has a template",
        "label": [
          {
            "format": "NONE: {name}",
            "when": "{cell|index} == -1"
          },
          {
            "format": "ERROR: {name}",
            "when": "{#group} != \"scnr\""
          },
          {
            "format": "{../designer/cells[{cell|index}]}: {name}",
            "when": "{../squad template index} == -1 && {cell|index} >= 0 && {cell|index} < {../designer/cells|count}"
          },
          {
            "format": "{../templated/cells[{cell|index}]}: {name}",
            "when": "{../squad template index} != -1 && {cell|index} >= 0 && {cell|index} < {../templated/cells|count}"
          },
          {
            "format": "BAD {cell|index}: {name}",
            "when": "1"
          }
        ]
      },
      "order_completion_condition": {
        "source": "halo3odst_mcc_guerilla.exe 0x140A93360",
