        {
          "type": "custom",
          "name": "Playfighting Modifiers",
          "group_tag": "fgrb"
        },
        {
          "type": "real",
          "name": "Playfight Burst Duration Mod: Burst duration is multiplied by this amount."
        },
        {
          "type": "real",
          "name": "Playfight Burst Error Mod: Multiplier applied to burst error."
        },
        {
          "type": "real",
          "name": "Playfight Burst Error Bonus: Amount add to burst error."
        },
        {
          "type": "real",
          "name": "Playfight Burst Radius Mod: Multiplier applied to pattern origin and return radius."
        },
        {
          "type": "real",
          "name": "Playfight Grenade Miss Distance: Offset in world units applied to grenade target points."
        },
        {
          "type": "real",
          "name": "Playfight Damage Mod: Multiplier applied to playfighting character's outgoing damage."
        },
        {
          "type": "custom",
          "name": null,
          "group_tag": "fgre"
        },
        {
          "type": "custom",
          "name": "AI Networking Parameters",
          "group_tag": "fgrb"
        },
        {
          "type": "explanation",
          "name": "IMPORTANT",
          "definition": "These parameters govern how AI is synced in distributed games. Do NOT touch them unless you know exactly what you are doing."
        },
        {
          "type": "real",
          "name": "Position discrepancy below which throttle fixups are used exclusively:world units#if position discrepancy is below this amount, throttle fixups are used exclusivley without any velocity bumps, blending, or warping"
        },
        {
          "type": "real",
          "name": "Positional discrepancy below which throttle fixups are NOT used if authority is stopped:world units#if authority is not moving and positional discrepancy is below this value, bump or blend rather than using throttle fixups"
        },
        {
          "type": "real",
          "name": "Predict ahead time:seconds#used to project the authoritative position into the future when calculating predicted throttle. smaller values mean converging on the authority more aggressively"
        },
        {
          "type": "explanation",
          "name": "Interpolation Settings",
          "definition": "Interpolation settings determine when and how warping, blending, and velocity bumps are applied to an object in networked games. For AI, we have several different sets of settings that are used depending on what the AI character is doing. When the character is not moving or is moving using regular locomotion, we use the default settings. When the character is executing an action that uses strict interpolation, we use the action interpolation settings."
        },
        {
          "type": "tag_reference",
          "name": "Simulation interpolation parameters",
          "definition": {
            "flags": 0,
            "allowed": [
              "siin"
            ]
          }
        },
        {
          "type": "tag_reference",
          "name": "Action simulation interpolation parameters",
          "definition": {
            "flags": 0,
            "allowed": [
              "siin"
            ]
          }
        },
        {
          "type": "real",
          "name": "Jump takeoff warp threshold:world units#if character is this far off from a jump takeoff point at the beginning of the jump, it is warped to the takeoff point"
        },
        {
          "type": "custom",
          "name": null,
          "group_tag": "fgre"
        },
        {
          "type": "real",
          "name": "default max active camouflage#The default percent change applied to active camo when ai_set_active_camo() is called"
        },
        {
          "type": "real",
          "name": "max player LOF crouch distance#Maximum distance from the player a unit can be to crouch when in its line of fire."
        },
        {
          "type": "real",
          "name": "player LOF crouch time#The time a unit stays in crouch after he has been in the players line of fire."
        },
        {
          "type": "custom",
          "name": "Slip Space Spawning",
          "group_tag": "fgrb"
        },
