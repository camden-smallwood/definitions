        {
          "type": "explanation",
          "name": "Forge Camera Manipulation",
          "definition": "Forge camera and manipulator parameters. Most of these only apply to the camera when you are grabbing >= 1 object."
        },
        {
          "type": "real",
          "name": "max object grab range#max possible distance at which monitor can grab an object. Small objects may not be grabbable at this distance. In absolute distance units."
        },
        {
          "type": "real",
          "name": "default grab distance mult#when you spawn an object, it'll be spawned defaultGrabDistanceMultiplier x object.boundingRadius out"
        },
        {
          "type": "real_bounds",
          "name": "min-max grab distance mult#auto-zoom brings you no closer/farther than multiplier x object.boundingRadius from grabbed object"
        },
        {
          "type": "real_bounds",
          "name": "minimum grab distance threshold#auto-zoom near can never leave these bounds"
        },
        {
          "type": "real_bounds",
          "name": "maximum grab distance threshold#auto-zoom far can never leave these bounds"
        },
        {
          "type": "real",
          "name": "lock-on time#it takes this long (seconds) for the camera to focus on grabbed objects when you lock on"
        },
        {
          "type": "real",
          "name": "grab-cam soft ceiling movement speed#when we're outside level bounds while grabbing item(s)"
        },
        {
          "type": "real",
          "name": "grab-cam inward spring constant#these control camera springiness for restoring position when we get blocked from our object"
        },
        {
          "type": "real",
          "name": "grab-cam outward spring constant#these control camera springiness for restoring position when we get blocked from our object"
        },
        {
          "type": "real",
          "name": "camera-object distance threshold#How far the camera can get from expected distance to object before we force camera position"
        },
        {
          "type": "real",
          "name": "translating-objects speed multiplier#When you're grabbing and translating objects, monitor speed is x this"
