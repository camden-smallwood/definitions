      "fields": [
        {
          "type": "struct",
          "name": "AnyTag",
          "definition": "_base_AnyTag"
        },
        {
          "type": "explanation",
          "name": "Simulated Input (SI)",
          "definition": "Adds accelerations into unit's movement (by simulating movement stick change) and/or view angle (by simulating camera stick change)"
        },
        {
          "type": "explanation",
          "name": "Impulse",
          "definition": "At SI spawn time the SI's angle is determined by adding the result of 'response type' & 'mapping type' to a random angle in given angle range.\nEach tick, this acceleration angle is multiplied by the final scaler resulting from logic below. That scaled impulse is then applied as stick input."
        },
        {
          "type": "explanation",
          "name": "Scalers",
          "definition": "Starting scaler value comes from damage multiplier or is set to 1.0 if SI not directly related to damage.\nThat is then scaled by the following:\n * area control falloff\n * function output y: func(SI_elapsed_time/duration) --> y)\n * 1 / zoom magnification\n * tick_delta_secs / tick_length\nresult of this is final scaler value"
        },
        {
          "type": "explanation",
          "name": "Screen Space angles",
          "definition": "0 - pitch up, +/-180 - pitch down\n-90 - yaw left, +90 - yaw right"
        },
        {
          "type": "explanation",
          "name": "Move",
          "definition": ""
        },
        {
          "type": "struct",
          "name": "move",
          "definition": "simulated_input_stick_struct"
        },
        {
          "type": "explanation",
          "name": "Look",
          "definition": ""
        },
        {
          "type": "struct",
          "name": "look",
          "definition": "simulated_input_stick_struct"
        },
        {
          "type": "terminator",
          "name": null
        }
      ],
      "__addr": "0x14471e240"
    },
